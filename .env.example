# Copie para .env e preencha.
FLASK_APP=main
# development | production
FLASK_CONFIG=development

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres

DATABASE_URI=postgresql://usuario:senha@localhost:5432/academia

# Fuso usado para vencimentos e aniversários
APP_TIMEZONE=America/Sao_Paulo
